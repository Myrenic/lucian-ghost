{{!-- One service panel. Same geometry as the static build's Card: py-4, a 4px
     gap, a hairline ring, 14px body. `icon`, `title`, `href`, `lead` and
     `items` (raw <li> markup) come from the caller. --}}
<li class="flex">
    <a class="group/card flex w-full rounded-xl focus-visible:outline-none" href="{{href}}">
        <div class="card h-full w-full ring-foreground/10 transition-colors group-hover/card:ring-primary/40 group-focus-visible/card:ring-primary">
            <div class="grid auto-rows-min items-start gap-1 px-4">
                <div class="flex items-start justify-between gap-3">
                    {{#match icon "briefcase"}}
                        {{> "icon-briefcase"}}
                    {{else match "idea"}}
                        {{> "icon-lightbulb"}}
                    {{else match "growing-chart"}}
                        {{> "icon-trending-up"}}
                    {{else}}
                        {{> "icon-settings"}}
                    {{/match}}
                    <svg class="size-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
                </div>
                <h3 class="font-heading leading-snug font-semibold">{{title}}</h3>
            </div>

            <div class="flex flex-1 flex-col gap-4 px-4 text-muted-foreground">
                <p class="leading-relaxed">{{{lead}}}</p>
                <ul class="mt-auto space-y-1.5 border-t pt-3 text-[0.9375rem]">
                    {{{items}}}
                </ul>
            </div>
        </div>
    </a>
</li>
