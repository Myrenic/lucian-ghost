{{!-- One service panel. Same geometry as the static build's Card: py-4, a 4px
     gap, a hairline ring, 14px body. `icon`, `title`, `href`, `lead` and
     `items` (raw <li> markup) come from the caller.

     The whole panel is the link, so the focus indicator is the global
     :focus-visible outline around the anchor itself; the card's own ring going
     2px maroon is the fallback for anything that never matches it. The arrow
     that used to sit opposite the icon is gone: the panel already says what it
     is with a title and a list, and the icon is the only thing that needs to
     lead the eye. --}}
<li class="flex">
    <a class="group/card flex w-full rounded-xl" href="{{href}}">
        <div class="card h-full w-full transition-colors group-hover/card:ring-primary/40 group-focus-visible/card:ring-2 group-focus-visible/card:ring-primary">
            <div class="grid auto-rows-min items-start gap-2 px-4">
                {{#match icon "briefcase"}}
                    {{> "icon-briefcase"}}
                {{else match "idea"}}
                    {{> "icon-lightbulb"}}
                {{else match "growing-chart"}}
                    {{> "icon-trending-up"}}
                {{else}}
                    {{> "icon-settings"}}
                {{/match}}
                {{!-- 16px, not 14: the title has to outweigh the list under it,
                      and the list is 14px. --}}
                <h3 class="font-heading text-base leading-snug font-semibold text-card-foreground">{{title}}</h3>
            </div>

            <div class="flex flex-1 flex-col gap-4 px-4 text-muted-foreground">
                <p class="leading-relaxed">{{{lead}}}</p>
                <ul class="mt-auto space-y-1.5 border-t pt-3 text-sm">
                    {{{items}}}
                </ul>
            </div>
        </div>
    </a>
</li>
