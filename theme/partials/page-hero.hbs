{{!-- The band under the header on interior pages: breadcrumb and title on the
     photograph. Pages are flat in Ghost, so the crumb is the site and the page. --}}
{{!-- Same 460px band as the homepage, so a page and the front page start alike. --}}
<section class="relative isolate flex min-h-[28.75rem] items-center overflow-hidden bg-foreground">
    {{#if @site.cover_image}}
        <img src="{{img_url @site.cover_image size="xl"}}" alt="" aria-hidden="true"
             class="absolute inset-0 -z-20 size-full object-cover object-[52%_28%] opacity-40">
    {{else}}
        <img src="{{asset "images/hero-1600.avif"}}" srcset="{{asset "images/hero-800.avif"}} 800w, {{asset "images/hero-1200.avif"}} 1200w, {{asset "images/hero-1600.avif"}} 1600w, {{asset "images/hero-2000.avif"}} 2000w"
             sizes="100vw" alt="" aria-hidden="true"
             class="absolute inset-0 -z-20 size-full object-cover object-[52%_28%] opacity-40">
    {{/if}}
    <div class="absolute inset-0 -z-10 bg-linear-to-b from-foreground/70 via-foreground/85 to-foreground" aria-hidden="true"></div>

    <div class="page py-16 text-center">
        {{!-- No breadcrumb: Ghost's pages are flat, so the trail was the site
              name followed by the page's own title, which the band then repeated
              underneath it. --}}

        {{#if @page.show_title_and_feature_image}}
            <h1 class="mx-auto max-w-4xl font-heading text-[clamp(1.75rem,3.2vw,2.875rem)] leading-[1.1] font-bold text-white text-balance">
                {{title}}
            </h1>
        {{/if}}
    </div>
</section>
