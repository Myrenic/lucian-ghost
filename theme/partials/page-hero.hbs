{{!-- The band under the header on interior pages: the page's name on the
     photograph. Pages are flat in Ghost, so there is no trail to draw.

     The same photograph and the same veil as the homepage, so a page and the
     front page start alike - the one deliberate difference is the height: 304px
     on a phone and 368px above it, not the homepage's 460px. A page title is
     one line; at 460px it owned most of the first screen on every one of the 42
     pages, and there is nothing else in this band. --}}
<section class="relative isolate flex min-h-[19rem] items-center overflow-hidden bg-foreground sm:min-h-[23rem]">
    {{#if @site.cover_image}}
        <img src="{{img_url @site.cover_image size="xl" format="webp"}}"
             srcset="{{img_url @site.cover_image size="m" format="webp"}} 960w, {{img_url @site.cover_image size="l" format="webp"}} 1280w, {{img_url @site.cover_image size="xl" format="webp"}} 2000w"
             sizes="100vw" alt="" aria-hidden="true" fetchpriority="high"
             class="absolute inset-0 -z-20 size-full object-cover object-[52%_28%]">
    {{else}}
        <img src="{{asset "images/hero-1600.avif"}}" srcset="{{asset "images/hero-800.avif"}} 800w, {{asset "images/hero-1200.avif"}} 1200w, {{asset "images/hero-1600.avif"}} 1600w, {{asset "images/hero-2000.avif"}} 2000w"
             sizes="100vw" alt="" aria-hidden="true" fetchpriority="high"
             class="absolute inset-0 -z-20 size-full object-cover object-[52%_28%]">
    {{/if}}
    <div class="absolute inset-0 -z-10 bg-veil-hero opacity-[0.63]" aria-hidden="true"></div>

    <div class="page py-12 text-center">
        {{!-- No breadcrumb: Ghost's pages are flat, so the trail was the site
              name followed by the page's own title, which the band then repeated
              underneath it. --}}

        {{#if @page.show_title_and_feature_image}}
            <h1 class="mx-auto max-w-4xl font-heading text-[clamp(1.75rem,3.2vw,2.875rem)] leading-[1.1] font-bold text-white text-balance">
                {{title}}
            </h1>
        {{/if}}
    </div>
</section>
