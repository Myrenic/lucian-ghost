{{!< default}}
{{!-- The article list, used by the Kenniscentrum collection. --}}
<section class="relative isolate overflow-hidden bg-foreground">
    <div class="absolute inset-0 -z-20">
        <img src="{{asset "images/hero-1600.avif"}}" alt="" aria-hidden="true"
             class="size-full object-cover object-[52%_28%] opacity-40">
    </div>
    <div class="absolute inset-0 -z-10 bg-linear-to-b from-foreground/70 via-foreground/85 to-foreground" aria-hidden="true"></div>

    <div class="page pt-28 pb-9 sm:pt-32 sm:pb-11">
        {{!-- This template also serves tag and author archives, and Ghost titles
              a plain collection with the site name, which is not its name. --}}
        <h1 class="font-heading text-[clamp(1.75rem,4vw,2.75rem)] leading-[1.1] font-semibold text-white text-balance">
            {{#if tag}}{{tag.name}}{{else}}{{#if author}}{{author.name}}{{else}}Artikelen{{/if}}{{/if}}
        </h1>
        {{#if description}}
            <p class="mt-3 max-w-2xl leading-relaxed text-background/75">{{description}}</p>
        {{/if}}
    </div>
</section>

<section class="band bg-background">
    <div class="page">
        <ul class="mx-auto max-w-3xl list-none space-y-8 p-0">
            {{#foreach posts}}
                <li class="border-t border-border pt-8 first:border-t-0 first:pt-0">
                    <a class="group/post block" href="{{url}}">
                        <h2 class="font-heading text-[clamp(1.25rem,2.1vw,1.5rem)] leading-snug font-semibold text-foreground group-hover/post:text-primary">
                            {{title}}
                        </h2>
                        <p class="mt-2 leading-relaxed text-muted-foreground">{{excerpt}}</p>
                        <p class="m-0 mt-3 flex items-center gap-x-3 text-sm text-muted-foreground">
                            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time>
                            <span aria-hidden="true">&middot;</span>
                            <span>{{reading_time}}</span>
                        </p>
                    </a>
                </li>
            {{/foreach}}
        </ul>

        {{#unless posts}}
            <p class="mx-auto max-w-3xl leading-relaxed text-muted-foreground">
                Er staan nog geen artikelen op deze site.
            </p>
        {{/unless}}

        {{#if pagination}}
            <nav class="mx-auto mt-12 flex max-w-3xl items-center justify-between gap-4 border-t border-border pt-6 text-sm"
                 aria-label="Paginering">
                {{#if pagination.prev}}
                    <a class="font-medium text-primary underline decoration-primary/35 underline-offset-4"
                       href="{{page_url pagination.prev}}">Nieuwere artikelen</a>
                {{else}}
                    <span></span>
                {{/if}}
                {{#if pagination.next}}
                    <a class="font-medium text-primary underline decoration-primary/35 underline-offset-4"
                       href="{{page_url pagination.next}}">Oudere artikelen</a>
                {{/if}}
            </nav>
        {{/if}}
    </div>
</section>
