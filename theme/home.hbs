{{!< default}}
{{!-- The homepage. The photograph, the tagline, the lead and two ways onward,
     then the statement band, the services, the quotes, and the latest
     Kenniscentrum articles when there are any. --}}
{{!-- The band is 460px with the text centred in it, which is what the
     client's own site does (measured); the rebuild had made it 640px with the
     text left-aligned. --}}
<section class="relative isolate flex min-h-[28.75rem] items-center justify-center overflow-hidden bg-foreground">
    {{#if @custom.hero_image}}
        {{!-- WebP, not the JPEG the upload was: this is the LCP element, and
              Ghost re-encodes it smaller than it can re-send the original. --}}
        <img src="{{img_url @custom.hero_image size="xl" format="webp"}}"
             srcset="{{img_url @custom.hero_image size="m" format="webp"}} 960w, {{img_url @custom.hero_image size="l" format="webp"}} 1280w, {{img_url @custom.hero_image size="xl" format="webp"}} 2000w"
             sizes="100vw" alt="" aria-hidden="true" fetchpriority="high"
             class="absolute inset-0 -z-20 size-full object-cover object-[52%_35%]">
    {{else}}
        <img src="{{asset "images/hero-1600.avif"}}"
             srcset="{{asset "images/hero-800.avif"}} 800w, {{asset "images/hero-1200.avif"}} 1200w, {{asset "images/hero-1600.avif"}} 1600w, {{asset "images/hero-2000.avif"}} 2000w"
             sizes="100vw" alt="" aria-hidden="true" fetchpriority="high"
             class="absolute inset-0 -z-20 size-full object-cover object-[52%_35%]">
    {{/if}}
    <div class="absolute inset-0 -z-10 bg-veil-hero opacity-[0.63]" aria-hidden="true"></div>

    <div class="page py-14 text-center">
        <h1 class="mx-auto max-w-4xl font-heading text-[clamp(1.75rem,3.2vw,2.875rem)] leading-[1.1] font-bold text-white text-balance">
            {{@custom.hero_heading}}
        </h1>
        <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-background text-pretty">
            {{@custom.hero_lead}}
        </p>
        <a class="btn btn-cta btn-primary mt-8" href="{{@custom.contact_url}}">Contact</a>
    </div>
</section>

{{!-- The statement, bracketed by two short rules as on the client's own site:
     theirs are 278px of #500000 above and below the line, not the
     left-and-right hairlines this had. --}}
<section class="bg-background">
    <div class="page py-12 sm:py-16">
        <div class="mx-auto flex max-w-4xl flex-col items-center gap-5 sm:gap-7">
            <span class="block h-[3px] w-[17.375rem] max-w-full bg-primary-deep" aria-hidden="true"></span>
            <h2 class="font-heading text-[1.5rem] leading-[1.3] font-medium text-muted-foreground text-center text-balance">
                {{@custom.statement}}
            </h2>
            <span class="block h-[3px] w-[17.375rem] max-w-full bg-primary-deep" aria-hidden="true"></span>
        </div>
    </div>
</section>

{{!-- The person, before the four things he sells. --}}
{{> "intro"}}

<section id="diensten" class="band bg-secondary">
    {{> "services"}}
</section>
{{> "testimonials"}}

{{!-- Written articles, once the client starts posting. --}}
{{#get "posts" limit="3"}}
    {{#if posts}}
        <section class="band bg-background">
            <div class="page">
                <div class="mx-auto max-w-3xl">
                    <h2 class="font-heading text-[clamp(1.375rem,2.6vw,1.875rem)] leading-[1.2] font-medium text-foreground">
                        Kenniscentrum
                    </h2>
                    <ul class="mt-8 list-none space-y-6 p-0">
                        {{#foreach posts}}
                            <li class="border-t border-border pt-6">
                                <a class="group/post block" href="{{url}}">
                                    <h3 class="font-heading font-semibold text-foreground group-hover/post:text-primary">{{title}}</h3>
                                    <p class="mt-2 leading-relaxed text-muted-foreground">{{excerpt}}</p>
                                    <time class="mt-2 block text-sm text-muted-foreground" datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time>
                                </a>
                            </li>
                        {{/foreach}}
                    </ul>
                    <p class="mt-8">
                        {{!-- /artikelen/ is the collection these posts live in;
                              /kenniscentrum/ is the client's own page about the
                              knowledge centre, which is not this list. --}}
                        <a class="inline-flex h-11 items-center font-medium text-primary underline decoration-primary/35 underline-offset-4 hover:decoration-primary"
                           href="/artikelen/">Alle artikelen</a>
                    </p>
                </div>
            </div>
        </section>
    {{/if}}
{{/get}}
