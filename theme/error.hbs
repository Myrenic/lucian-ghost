{{!< default}}
{{!-- Everything Ghost cannot serve: a missing page, a server error. --}}
<section class="bg-background py-20 sm:py-28">
    <div class="page flex justify-center">
        <div class="w-full max-w-3xl">
            <p class="m-0 text-[0.75rem] font-semibold tracking-[0.14em] text-primary uppercase">
                {{statusCode}}
            </p>
            <h1 class="mt-3 font-heading text-[clamp(1.75rem,3.4vw,2.5rem)] leading-[1.12] font-semibold text-foreground">
                {{#match statusCode 404}}Pagina niet gevonden{{else}}Er ging iets mis{{/match}}
            </h1>
            <p class="mt-4 leading-[1.7] text-muted-foreground">
                {{#match statusCode 404}}
                    Deze pagina bestaat niet of is verplaatst. Ga terug naar de homepage of stuur een
                    bericht via het contactformulier.
                {{else}}
                    {{message}}. Probeer het later opnieuw of ga terug naar de homepage.
                {{/match}}
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
                <a class="btn btn-cta btn-primary" href="{{@site.url}}">Terug naar de homepage</a>
                <a class="btn btn-cta btn-outline" href="{{@custom.contact_url}}">Neem contact op</a>
            </div>
        </div>
    </div>
</section>
